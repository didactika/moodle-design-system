---
import project from '../data/project.generated.json';
import versions from '../data/versions.json';
import theme from '../data/theme.json';
import system from '../data/system.json';
import {languages, ui, type Lang} from '../i18n/ui';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

/** The bar at the top of every page: brand, the page search, Moodle version, language, colour mode, designer mode, the Didactika colours and the links of the project. */
interface Props {
    lang: Lang;
    /** Slug of the page, so the language menu can point at the same page in the other language. Empty on the home page. */
    slug: string;
    /** Show the button that opens the navigation (pages that have one). */
    menu?: boolean;
}
const {lang, slug, menu = true} = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (l: string, s: string) => `${base}/${l}/${s ? s + '/' : ''}`;
const {organisation, repository, funding} = project;
const modes = [['light', 'sun', t.light], ['system', 'auto', t.system], ['dark', 'moon', t.dark]] as const;
---

<header class="ds-head">
    <div class="ds-head-left">
        {menu && <button class="ds-iconbtn ds-menu-btn" id="ds-menu" type="button" aria-controls="ds-nav" aria-expanded="false" aria-label={t.menu}><Icon name="bars" /></button>}
        <a class="ds-brand" href={href(lang, '')} aria-label={t.site}>
            <Logo />
            <span class="ds-wordmark"><strong>Moodle Design System</strong><small>by Didactika</small></span>
        </a>
    </div>
    <div class="ds-head-versions" id="ds-versions">
    <details class="ds-dd" id="ds-version">
        <summary aria-label={t.version} title={t.version}>
            <Icon name="layers" /><span id="ds-version-label"><span class="ds-vl">Moodle </span>{versions[0].label.replace(/^Moodle /, '')}</span>
        </summary>
        <ul class="ds-dd-list" role="menu" aria-label={t.version}>
            {versions.map((v) => (
                <li role="none">
                    <button type="button" role="menuitemradio" aria-checked="false" data-version={v.id}>
                        <b>{v.label}</b>
                        <span class="ds-check"><Icon name="check" /></span>
                        <small>{t.bootstrap} {v.bootstrap} · {v.icons === 'fa4' ? 'Font Awesome 4.7' : 'Font Awesome 6'} · {v.support[lang]}</small>
                    </button>
                </li>
            ))}
        </ul>
    </details>
    <details class="ds-dd ds-dd-icon ds-sysver" id="ds-sysver">
        <summary aria-label={t.systemVersion} title={t.systemVersion}><Icon name="cubes" /><span id="ds-sysver-label">v{system.default}</span></summary>
        <ul class="ds-dd-list ds-dd-narrow" role="menu" aria-label={t.systemVersion}>
            {system.versions.map((v) => (
                <li role="none">
                    <button type="button" role="menuitemradio" aria-checked="false" data-system-version={v.id}>
                        <b>{v.label}</b><span class="ds-check"><Icon name="check" /></span>
                        <small>{v.status[lang]}</small>
                    </button>
                </li>
            ))}
        </ul>
    </details>
    </div>
    <div class="ds-search" id="ds-search" data-open="false">
        <div class="ds-search-bar">
            <button type="button" class="ds-search-open" id="ds-search-open" aria-label={t.searchOpen} title={`${t.searchOpen} (Ctrl K)`}><Icon name="search" /><span class="ds-search-label">{t.search}</span><kbd>Ctrl K</kbd></button>
            <input class="ds-search-input" id="ds-search-input" type="search" role="combobox" aria-expanded="false" aria-controls="ds-search-results" aria-autocomplete="list" autocomplete="off" spellcheck="false" placeholder={t.search} aria-label={t.search} />
            <button type="button" class="ds-search-close" id="ds-search-close" aria-label={t.searchClose}><kbd>Esc</kbd></button>
        </div>
        <div class="ds-search-panel" id="ds-search-panel" hidden>
            <ul class="ds-search-results" id="ds-search-results" role="listbox" aria-label={t.search}></ul>
            <p class="ds-search-empty" id="ds-search-empty" hidden>{t.searchEmpty}</p>
            <p class="ds-search-keys">{t.searchKeys}</p>
        </div>
    </div>
    <button type="button" class="ds-iconbtn ds-tools-btn" id="ds-tools-btn" aria-controls="ds-tools" aria-expanded="false" aria-label={t.tools} title={t.tools}><Icon name="sliders" /></button>
    <div class="ds-head-tools" id="ds-tools">
        <details class="ds-dd ds-dd-icon" id="ds-lang">
            <summary aria-label={t.language} title={t.language}><Icon name="globe" /><span class="ds-code2">{lang.toUpperCase()}</span></summary>
            <ul class="ds-dd-list ds-dd-narrow" role="menu" aria-label={t.language}>
                {(Object.keys(languages) as Lang[]).map((l) => (
                    <li role="none">
                        <a role="menuitemradio" aria-checked={l === lang ? 'true' : 'false'} href={href(l, slug)} hreflang={l} lang={l}>
                            <b>{languages[l]}</b><span class="ds-check"><Icon name="check" /></span>
                        </a>
                    </li>
                ))}
            </ul>
        </details>

        <details class="ds-dd ds-dd-icon" id="ds-mode">
            <summary aria-label={t.theme} title={t.theme}>
                <span class="ds-mode-i is-light"><Icon name="sun" /></span><span class="ds-mode-i is-dark"><Icon name="moon" /></span><span class="ds-mode-i is-auto"><Icon name="auto" /></span>
            </summary>
            <ul class="ds-dd-list ds-dd-narrow" role="menu" aria-label={t.theme}>
                {modes.map(([mode, icon, label]) => (
                    <li role="none">
                        <button type="button" role="menuitemradio" aria-checked="false" data-set-mode={mode}>
                            <span class="ds-dd-row"><Icon name={icon} />{label}</span><span class="ds-check"><Icon name="check" /></span>
                        </button>
                    </li>
                ))}
            </ul>
        </details>

        <button type="button" class="ds-iconbtn ds-designer-btn" data-designer-toggle aria-pressed="false" title={`${t.designerMode}: ${t.designerHelp}`} aria-label={t.designerMode}><Icon name="designer" /></button>

        <div class="ds-theme">
            <button type="button" class="ds-brandsw" data-brand-toggle aria-pressed="false" title={t.brandThemeHelp}>
                <span class="ds-brandsw-mark"><Icon name="swatch" /></span>
                <span class="ds-brandsw-label">{t.brandTheme}</span>
                <span class="ds-switch" aria-hidden="true"><i></i></span>
            </button>
        </div>

        <span class="ds-head-sep" aria-hidden="true"></span>
        {organisation.website && <a class="ds-iconbtn ds-site-link" href={organisation.website} title={t.linkWebsite} aria-label={t.linkWebsite}><img src={`${base}/brand/didactika-logo.png`} alt="" width="20" height="20" /></a>}
        {funding && <a class="ds-iconbtn ds-heart" href={funding.url} rel="noopener" title={`${t.support} · ${funding.platform}`} aria-label={`${t.support} · ${funding.platform}`}><Icon name="heart" /></a>}
        <a class="ds-iconbtn ds-github" href={repository.url} title="GitHub" aria-label="GitHub"><Icon name="github" /></a>
    </div>
</header>
