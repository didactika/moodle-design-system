---
import project from '../data/project.generated.json';
import {ui, type Lang} from '../i18n/ui';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

/**
 * The foot of every page. It stays one row however much the project grows. Everything in it comes from GitHub (`tools/fetch-project.ts`): the
 * co-founders are the owners of the organisation, the collaborators are its contributors (refreshed in the browser with its public members) and
 * cut at a maximum, the rest being a "+ n" that leads to the full list.
 */
interface Props {
    lang: Lang;
}
const {lang} = Astro.props;
const t = ui[lang];
const f = t.foot;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const {organisation, repository, founders, funding} = project;
const max = 8;
const cofounders = new Set(founders.map((p) => p.login.toLowerCase()));
/** Everyone who has contributed to the repositories of the organisation, except the co-founders, who are shown on their own. */
const seed = project.contributors.filter((p) => !cofounders.has(p.login.toLowerCase()));
const shown = seed.slice(0, max);
const host = organisation.website ? new URL(organisation.website).host : null;
---

<footer class="ds-footer">
    <div class="ds-footer-in">
        <div class="ds-foot-row">
            <a class="ds-foot-brand" href={`${base}/${lang}/`}>
                <Logo size="lg" />
                <span><b>Didactika Moodle UI</b><span>{f.about}</span></span>
            </a>

            <div class="ds-foot-people">
                <ul class="ds-founders" aria-label={f.cofounders}>
                    {founders.map((p) => (
                        <li>
                            <a class="ds-founder" href={p.url} title={`${p.name ?? p.login} · GitHub`}>
                                <img src={`${p.avatar}${p.avatar.includes('?') ? '&' : '?'}s=64`} alt="" width="32" height="32" loading="lazy" />
                                <span><b>{p.name ?? p.login}</b><small>{f.cofounder}</small></span>
                            </a>
                        </li>
                    ))}
                </ul>
                <div class:list={['ds-collabs', {'has-people': seed.length > 0}]} data-people data-org={organisation.login} data-exclude={[...cofounders].join(',')} data-max={max} data-all={organisation.peopleUrl} data-more={f.moreCollaborators} data-seed={JSON.stringify(seed)}>
                    <span class="ds-collabs-label">{f.collaborators}</span>
                    <span class="ds-stack" data-people-list>{shown.map((p) => <a href={p.url} title={p.login} aria-label={p.login}><img src={`${p.avatar}${p.avatar.includes('?') ? '&' : '?'}s=64`} alt="" width="32" height="32" loading="lazy" /></a>)}{seed.length > max && <a class="more" href={organisation.peopleUrl} title={f.moreCollaborators}>+{seed.length - max}</a>}</span>
                    <a class="ds-collab-add" href={organisation.repositoriesUrl} title={f.join} aria-label={f.join}><Icon name="userplus" /></a>
                </div>
            </div>

            <nav class="ds-foot-links" aria-label={f.links}>
                {organisation.website && <a href={organisation.website}><img src={organisation.avatar ?? `${base}/brand/didactika-logo.png`} alt="" width="16" height="16" />{host}</a>}
                <a href={organisation.url}><Icon name="github" />github.com/{organisation.login}</a>
            </nav>
        </div>

        <div class="ds-footer-bar">
            <span>© {organisation.login}{repository.licence && ` · ${repository.licence}`}</span>
            {funding ? <a class="ds-support-link" href={funding.url} rel="noopener"><Icon name="heart" />{f.supportLink}</a> : <span></span>}
            <span>{f.credits}</span>
        </div>
    </div>
</footer>
