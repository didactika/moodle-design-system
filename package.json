{
  "name": "moodle-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The design system of Didactika's Moodle plugins, as a static site.",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "moodle": "node tools/build-moodle.mjs",
