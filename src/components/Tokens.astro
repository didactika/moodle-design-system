---
import tokens from '../data/tokens.json';

/** The colours of the theme, or the colour scales of Moodle 5.3, read from the stylesheet of the selected version. */
interface Props {
    kind: 'theme' | 'scale';
}
const {kind} = Astro.props;
---

<div class:list={["ds-v-scope", {"ds-swatches": kind === "theme"}]} data-tokens={kind}></div>
<script type="application/json" id="ds-tokens-data" set:html={JSON.stringify(tokens)} is:inline />
