---
/** The Didactika logo for this site: the organisation's mark on a tile, with the handles of a selection and the cap of Moodle in a badge on the corner. */
interface Props {
    size?: 'sm' | 'lg';
}
const {size = 'sm'} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<span class:list={['ds-logo', {'is-lg': size === 'lg'}]} aria-hidden="true">
    <img src={`${base}/brand/didactika-logo.png`} alt="" width="64" height="64" />
    <i class="h h1"></i><i class="h h2"></i><i class="h h3"></i>
    <b class="ds-logo-ui"><img src={`${base}/brand/moodle-cap.svg`} alt="" width="24" height="20" /></b>
</span>
