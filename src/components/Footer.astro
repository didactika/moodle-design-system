---
import config from '../config/site.json';
import {ui, type Lang} from '../i18n/ui';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

/**
 * The foot of every page. It stays one row however much the project grows: the co-founders are the people of the configuration, the
 * collaborators are read from GitHub when the page opens and cut at a maximum (the rest is a "+ n" that leads to the full list).
 */
interface Props {
    lang: Lang;
}
const {lang} = Astro.props;
const t = ui[lang];
const f = t.foot;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const c = config.collaborators;
---

<footer class="ds-footer">
    <div class="ds-footer-in">
        <div class="ds-foot-row">
            <a class="ds-foot-brand" href={`${base}/${lang}/`}>
                <Logo size="lg" />
                <span><b>Didactika Moodle UI</b><span>{f.about}</span></span>
            </a>

            <div class="ds-foot-people">
                <ul class="ds-founders" aria-label={f.cofounders}>
                    {config.cofounders.map((p) => (
                        <li>
                            <a class="ds-founder" href={`https://github.com/${p.github}`} title={`${p.name} · GitHub`}>
                                <img src={`https://github.com/${p.github}.png?size=64`} alt="" width="32" height="32" loading="lazy" />
                                <span><b>{p.name}</b><small>{f.cofounder}</small></span>
                            </a>
                        </li>
                    ))}
                </ul>
                <div class="ds-collabs" data-people data-org={c.org} data-exclude={c.exclude.join(',')} data-max={c.max} data-all={c.all} data-more={f.moreCollaborators}>
                    <span class="ds-collabs-label">{f.collaborators}</span>
                    <span class="ds-stack" data-people-list></span>
                    <a class="ds-collab-add" href={c.join} title={f.join} aria-label={f.join}><Icon name="userplus" /></a>
                </div>
            </div>

            <nav class="ds-foot-links" aria-label={f.links}>
                <a href={config.organisation.website}><img src={`${base}/brand/didactika-logo.png`} alt="" width="16" height="16" />didactika.org</a>
                <a href={config.organisation.github}><Icon name="github" />github.com/didactika</a>
            </nav>
        </div>

        <div class="ds-footer-bar">
            <span>© Didactika · GPL-3.0-or-later</span>
            <a class="ds-support-link" href={config.support.url} rel="noopener"><Icon name="heart" />{f.supportLink}</a>
            <span>{f.credits}</span>
        </div>
    </div>
</footer>
