---
import {getCollection} from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import versions from '../../data/versions.json';
import icons from '../../data/icons.json';
import tokens from '../../data/tokens.json';
import {ui, type Lang} from '../../i18n/ui';
import {home} from '../../i18n/home';

export function getStaticPaths() {
    return [{params: {lang: 'en'}}, {params: {lang: 'es'}}];
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];
const h = home[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (s: string) => `${base}/${lang}/${s}/`;

const pages = (await getCollection('docs')).filter((e) => e.id.startsWith(lang + '/'));
const count = (group: string) => pages.filter((e) => e.data.group === group).length;
const groups = (['foundations', 'bootstrap', 'moodle', 'didactika', 'patterns', 'guides'] as const).map((key) => ({
    key,
    label: t.groups[key],
    text: h.groupText[key],
    pages: count(key),
    first: pages.filter((e) => e.data.group === key).sort((a, b) => a.data.order - b.data.order)[0],
}));
const groupIcon = {foundations: 'palette', bootstrap: 'cubes', moodle: 'puzzle', didactika: 'layers', patterns: 'sparkles', guides: 'book'} as const;
const stats = [
    [versions.length, h.stats.versions],
    [Object.keys(icons).length, h.stats.icons],
    [Object.keys(tokens.v53.light).length + Object.keys(tokens.v53.dark).length, h.stats.tokens],
    [2, h.stats.languages],
    [pages.length, h.stats.pages],
] as const;
const brand = [['teal-50', '#f0fdfa'], ['teal-100', '#ccfbf1'], ['teal-300', '#5eead4'], ['teal-500', '#14b8a6'], ['teal-600', '#0d9488'], ['teal-700', '#0f766e'], ['logo', '#00555a'], ['teal-900', '#134e4a']];
const [before, after] = h.title.split(h.accent);
---

<Base lang={lang} title={t.site} summary={h.lead} slug="" menu={false}>
    <main class="ds-home" id="content">
        <section class="ds-hero">
            <div class="ds-hero-copy">
                <span class="ds-pill"><Icon name="check" />{h.badge}</span>
                <h1>{before}<em>{h.accent}</em>{after}</h1>
                <p class="ds-lead">{h.lead}</p>
                <div class="ds-cta">
                    <a class="ds-cta-main" href={href('bootstrap/buttons')}>{h.ctaPrimary}<Icon name="arrow" /></a>
                    <a class="ds-cta-alt" href={href('foundations/colour')}>{h.ctaSecondary}</a>
                    <a class="ds-cta-alt" href={href('start/introduction')}>{h.ctaTertiary}</a>
                </div>
                <ul class="ds-vers" aria-label={t.version}>
                    {versions.map((v) => <li><span class:list={['ds-dot2', {on: v.id === 'v53'}]}></span>{v.label}</li>)}
                </ul>
            </div>

            <div class="ds-art" aria-hidden="true">
                <div class="ds-art-label">{h.artboard}</div>
                <div class="ds-art-frame">
                    <div class="ds-art-card">
                        <img src={`${base}/brand/didactika-logo.png`} alt="" width="132" height="132" />
                        <b>Didactika</b>
                        <span>Moodle UI</span>
                    </div>
                    <div class="ds-art-item ds-art-btns ds-v-scope">
                        <div class="ds-selbox">
                            <i></i><i></i><i></i><i></i>
                            <span class="ds-seltag">{h.mini.sel} · 126 × 38</span>
                            <button type="button" class="btn btn-primary" tabindex="-1">{h.mini.save}</button>
                        </div>
                        <button type="button" class="btn btn-outline-secondary" tabindex="-1">{h.mini.cancel}</button>
                    </div>
                    <div class="ds-art-item ds-art-progress ds-v-scope">
                        <div class="progress" style="width:9.5rem"><div class="progress-bar" style="width:68%"></div></div>
                    </div>
                    <div class="ds-art-item ds-art-alert ds-v-scope">
                        <div class="alert alert-success mb-0 py-2 px-3">{h.mini.done}</div>
                    </div>
                    <div class="ds-art-item ds-art-swatches">
                        {['#00555a', '#0f766e', '#14b8a6', '#5eead4', '#ccfbf1'].map((c) => <i style={`background:${c}`}></i>)}
                    </div>
                    <div class="ds-cursor ds-cursor-a"><Icon name="pointer" /><span>Design</span></div>
                    <div class="ds-cursor ds-cursor-b"><Icon name="pointer" /><span>Moodle</span></div>
                </div>
            </div>
        </section>

        <section class="ds-stats" aria-label="Stats">
            {stats.map(([n, label]) => <div><b>{n}</b><span>{label}</span></div>)}
        </section>

        <section class="ds-block">
            <header><h2>{h.principlesTitle}</h2><p>{h.principlesLead}</p></header>
            <div class="ds-cards">
                {h.principles.map((p) => (
                    <article class="ds-card">
                        <span class="ds-card-i"><Icon name={p.icon} /></span>
                        <h3>{p.title}</h3>
                        <p>{p.text}</p>
                    </article>
                ))}
            </div>
        </section>

        <section class="ds-block">
            <header><h2>{h.exploreTitle}</h2><p>{h.exploreLead}</p></header>
            <div class="ds-cards ds-cards-groups">
                {groups.map((g) => {
                    const ready = g.pages > 0;
                    const Tag = ready ? 'a' : 'div';
                    return (
                        <Tag class:list={['ds-card', 'ds-card-link', {'is-soon': !ready}]} href={ready ? href(g.first.id.slice(lang.length + 1)) : undefined}>
                            <span class="ds-card-i"><Icon name={groupIcon[g.key]} /></span>
                            <h3>{g.label}</h3>
                            <p>{g.text}</p>
                            <span class="ds-card-meta">{ready ? `${g.pages} ${g.pages === 1 ? h.pagesOne : h.pagesMany}` : h.soon}{ready && <Icon name="arrow" />}</span>
                        </Tag>
                    );
                })}
            </div>
        </section>

        <section class="ds-block ds-brand-block">
            <header><h2>{h.paletteTitle}</h2><p>{h.paletteLead}</p></header>
            <div class="ds-brand-strip">
                {brand.map(([name, value]) => <div style={`background:${value};color:${['teal-50', 'teal-100', 'teal-300'].includes(name) ? '#134e4a' : '#fff'}`}><b>{name}</b><span>{value}</span></div>)}
            </div>
            <a class="ds-cta-alt" href={href('foundations/colour')}>{h.paletteCta}<Icon name="arrow" /></a>
        </section>

        <footer class="ds-foot">
            <span class="ds-logo"><img src={`${base}/brand/didactika-logo.png`} alt="" width="28" height="28" /></span>
            <p>{h.footer}</p>
            <nav>
                <a href="https://didactika.org">{h.footerLinks.site}</a>
                <a href="https://github.com/didactika/moodle-design-system">{h.footerLinks.repo}</a>
                <span>{h.footerLinks.licence}</span>
            </nav>
        </footer>
    </main>
</Base>
