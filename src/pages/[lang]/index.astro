---
import {getCollection} from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Logo from '../../components/Logo.astro';
import versions from '../../data/versions.json';
import icons from '../../data/icons.json';
import tokens from '../../data/tokens.json';
import {ui, type Lang} from '../../i18n/ui';
import {home} from '../../i18n/home';

export function getStaticPaths() {
    return [{params: {lang: 'en'}}, {params: {lang: 'es'}}];
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];
const h = home[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (s: string) => `${base}/${lang}/${s}/`;

const pages = (await getCollection('docs')).filter((e) => e.id.startsWith(lang + '/'));
const count = (group: string) => pages.filter((e) => e.data.group === group).length;
const groups = (['foundations', 'bootstrap', 'moodle', 'didactika', 'patterns', 'guides'] as const).map((key) => ({
    key,
    label: t.groups[key],
    text: h.groupText[key],
    pages: count(key),
    first: pages.filter((e) => e.data.group === key).sort((a, b) => a.data.order - b.data.order)[0],
}));
const groupIcon = {foundations: 'palette', bootstrap: 'cubes', moodle: 'puzzle', didactika: 'layers', patterns: 'sparkles', guides: 'book'} as const;
const stats = [
    [versions.length, h.stats.versions],
    [Object.keys(icons).length, h.stats.icons],
    [Object.keys(tokens.v53.light).length + Object.keys(tokens.v53.dark).length, h.stats.tokens],
    [2, h.stats.languages],
    [pages.length, h.stats.pages],
] as const;
const [before, after] = h.title.split(h.accent);
---

<Base lang={lang} title={t.site} summary={h.lead} slug="" menu={false}>
    <main class="ds-home" id="content">
        <section class="ds-hero">
            <div class="ds-hero-copy">
                <span class="ds-pill"><Icon name="check" />{h.badge}</span>
                <h1>{before}<em>{h.accent}</em>{after}</h1>
                <p class="ds-lead">{h.lead}</p>
                <div class="ds-cta">
                    <a class="ds-cta-main" href={href('bootstrap/buttons')}>{h.ctaPrimary}<Icon name="arrow" /></a>
                    <a class="ds-cta-alt" href={href('foundations/colour')}>{h.ctaSecondary}</a>
                    <a class="ds-cta-alt" href={href('start/introduction')}>{h.ctaTertiary}</a>
                </div>
            </div>

            <div class="ds-art" aria-hidden="true">
                <div class="ds-art-label">{h.artboard}</div>
                <div class="ds-art-frame">
                    <div class="ds-art-card">
                        <Logo size="lg" />
                        <b>Moodle</b>
                        <span>Design System · Didactika</span>
                    </div>
                    <div class="ds-art-item ds-art-swatches">
                        {['#00555a', '#0f766e', '#14b8a6', '#5eead4', '#ccfbf1'].map((c) => <i style={`background:${c}`}></i>)}
                    </div>
                    <div class="ds-art-item ds-art-progress"><i></i></div>
                    <div class="ds-art-item ds-art-btns">
                        <span class="ds-selbox"><i></i><i></i><i></i><i></i><b class="ds-seltag">{h.mini.sel} · 96 × 36</b><span class="ds-mini-btn is-solid">{h.mini.save}</span></span>
                        <span class="ds-mini-btn">{h.mini.cancel}</span>
                    </div>
                    <div class="ds-art-item ds-art-alert">{h.mini.done}</div>
                    <div class="ds-cursor ds-cursor-a"><Icon name="pointer" /><span>Design</span></div>
                    <div class="ds-cursor ds-cursor-b"><Icon name="pointer" /><span>Moodle</span></div>
                </div>
            </div>
        </section>

        <section class="ds-try" aria-labelledby="ds-try-title">
            <header><h2 id="ds-try-title">{h.tryTitle}</h2><p>{h.tryLead}</p></header>
            <div class="ds-try-grid">
                <div class="ds-try-controls">
                    <div class="ds-try-row">
                        <div class="ds-try-label"><b><Icon name="layers" />{h.tryVersion}</b><span>{h.tryVersionHelp}</span></div>
                        <div class="ds-chips" role="group" aria-label={h.tryVersion}>
                            {versions.map((v) => <button type="button" data-pick-version={v.id} aria-pressed="false"><b>{v.moodle}</b><small>{v.id === 'v41' ? 'legacy' : 'LTS'}</small></button>)}
                        </div>
                    </div>
                    <div class="ds-try-row">
                        <div class="ds-try-label"><b><Icon name="swatch" />{h.tryTheme}</b><span>{h.tryThemeHelp}</span></div>
                        <button type="button" class="ds-switchbtn" data-brand-toggle aria-pressed="false" aria-label={h.tryTheme}><span class="ds-switch" aria-hidden="true"><i></i></span></button>
                    </div>
                    <div class="ds-try-row">
                        <div class="ds-try-label"><b><Icon name="pointer" />{h.tryInspect}</b><span>{h.tryInspectHelp}</span></div>
                    </div>
                </div>
                <div class="ds-livebox ds-v-scope" aria-label={h.sampleTitle}>
                    <div class="ds-live-row">
                        <button type="button" class="btn btn-primary" tabindex="-1">{h.mini.save}</button>
                        <button type="button" class="btn btn-outline-secondary" tabindex="-1">{h.mini.cancel}</button>
                        <button type="button" class="btn btn-danger" tabindex="-1">{h.mini.del}</button>
                    </div>
                    <div class="alert alert-success mb-0" role="status">{h.sampleAlert}</div>
                    <div class="ds-live-row">
                        <input class="form-control" type="text" value={h.sampleInput} aria-label={h.sampleInput} style="max-width:14rem" />
                        <span class="badge bg-primary text-white">primary</span>
                        <span class="badge bg-success text-white">success</span>
                    </div>
                    <div class="progress" role="progressbar" aria-label="62%" aria-valuenow="62" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:62%"></div></div>
                </div>
            </div>
        </section>

        <section class="ds-stats" aria-label="Stats">
            {stats.map(([n, label]) => <div><b>{n}</b><span>{label}</span></div>)}
        </section>

        <section class="ds-block">
            <header><h2>{h.exploreTitle}</h2><p>{h.exploreLead}</p></header>
            <div class="ds-cards ds-cards-groups">
                {groups.map((g) => {
                    const ready = g.pages > 0;
                    const Tag = ready ? 'a' : 'div';
                    return (
                        <Tag class:list={['ds-card', 'ds-card-link', {'is-soon': !ready}]} href={ready ? href(g.first.id.slice(lang.length + 1)) : undefined}>
                            <span class="ds-card-i"><Icon name={groupIcon[g.key]} /></span>
                            <h3>{g.label}</h3>
                            <p>{g.text}</p>
                            <span class="ds-card-meta">{ready ? `${g.pages} ${g.pages === 1 ? h.pagesOne : h.pagesMany}` : h.soon}{ready && <Icon name="arrow" />}</span>
                        </Tag>
                    );
                })}
            </div>
        </section>

        <section class="ds-block">
            <header><h2>{h.principlesTitle}</h2><p>{h.principlesLead}</p></header>
            <div class="ds-cards">
                {h.principles.map((p) => (
                    <article class="ds-card">
                        <span class="ds-card-i"><Icon name={p.icon} /></span>
                        <h3>{p.title}</h3>
                        <p>{p.text}</p>
                    </article>
                ))}
            </div>
        </section>
    </main>
</Base>
