---
/** A set of colours read from the selected Moodle version (or Didactika's own): brand, theme, surface, subtle, palette, grays, scale. */
interface Props {
    kind: 'brand' | 'theme' | 'surface' | 'subtle' | 'palette' | 'grays' | 'scale';
}
const {kind} = Astro.props;
---

<div data-colours={kind}></div>
