---
import versions from '../data/versions.json';
import icons from '../data/icons.json';
import {ui, type Lang} from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';

/** What every page shares: the head (fonts, favicons, the Moodle stylesheets), the header, the data the script reads and the script. */
interface Props {
    lang: Lang;
    title: string;
    summary: string;
    /** The page's slug without the language, so the language switch can point at it. Empty on the home page. */
    slug: string;
    /** Whether the page has a navigation the header can open. */
    menu?: boolean;
}

const {lang, title, summary, slug, menu = true} = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = new URL(base + '/', Astro.site ?? 'https://didactika.github.io').href.replace(/\/$/, '');
const versionData = versions.map((v) => ({id: v.id, moodle: v.moodle, label: v.label, bootstrap: v.bootstrap, icons: v.icons, darkMode: v.darkMode, support: v.support[lang]}));
---

<!doctype html>
<html lang={lang} data-version="v53">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <title>{title === t.site ? title : `${title} · ${t.site}`}</title>
        <meta name="description" content={summary} />
        <meta name="theme-color" content="#0f766e" />
        <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
        <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
        <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
        <meta property="og:site_name" content={t.site} />
        <meta property="og:title" content={title === t.site ? title : `${title} · ${t.site}`} />
        <meta property="og:description" content={summary} />
        <meta property="og:image" content={`${site}/brand/og-image.png`} />
        <meta property="og:type" content="website" />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="apple-touch-icon" href={`${base}/brand/apple-touch-icon.png`} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" />
        {versions.map((v) => <link rel="stylesheet" data-version-css={v.id} href={`${base}/moodle/${v.id}/boost.css`} media="not all" />)}
        <script is:inline define:vars={{versionIds: versions.map((v) => v.id)}}>
            // Before the first paint: the version, the colour mode and the Didactika colours, and the Moodle stylesheet that goes with them.
            // A link can carry them (?version=v45&mode=dark&brand=1), so another site can open a page in the state it wants to show.
            const root = document.documentElement;
            const query = new URLSearchParams(location.search);
            let version = null; let mode = null; let brand = null;
            try { version = localStorage.getItem('ds-version'); mode = localStorage.getItem('ds-mode'); brand = localStorage.getItem('ds-brand'); } catch (e) { /* the page works without storage */ }
            version = query.get('version') ?? version;
            mode = query.get('mode') ?? mode;
            brand = query.get('brand') ?? brand;
            root.dataset.version = versionIds.includes(version) ? version : 'v53';
            if (mode === 'light' || mode === 'dark') { root.dataset.theme = mode; }
            root.dataset.brand = brand === '1' ? '1' : '0';
            document.querySelectorAll('[data-version-css]').forEach((l) => { l.media = l.dataset.versionCss === document.documentElement.dataset.version ? 'all' : 'not all'; });
        </script>
    </head>
    <body>
        <a class="ds-skip" href="#content">{t.skip}</a>
        <Header lang={lang} slug={slug} menu={menu} />
        <slot />
        <Footer lang={lang} />
        <script type="application/json" id="ds-icons-data" set:html={JSON.stringify(icons)} is:inline />
        <script type="application/json" id="ds-config" set:html={JSON.stringify({versions: versionData, lang, ui: t})} />
        <script>
            import '../scripts/site.js';
        </script>
    </body>
</html>
