---
/** The logo of this site: the mark of Didactika on its teal tile, and the cap of Moodle in a badge on the corner (public/brand/logo.svg). */
interface Props {
    size?: 'sm' | 'lg';
}
const {size = 'sm'} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<span class:list={['ds-logo', {'is-lg': size === 'lg'}]} aria-hidden="true">
    <img src={`${base}/brand/logo.svg`} alt="" width="64" height="64" />
</span>
