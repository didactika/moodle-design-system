---
export function getStaticPaths() {
    return [{params: {lang: 'en'}}, {params: {lang: 'es'}}];
}
const {lang} = Astro.params;
const target = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${lang}/start/introduction/`;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <meta http-equiv="refresh" content={`0; url=${target}`} />
        <link rel="canonical" href={target} />
        <title>Didactika Moodle UI</title>
    </head>
    <body><a href={target}>Didactika Moodle UI</a></body>
</html>
